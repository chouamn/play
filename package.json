{
  "name": "isr-2027-automation",
  "private": true,
  "scripts": {
    "test": "ts-node src/utilities/RunTests.ts",
    "test:home": "ts-node src/utilities/RunTests.ts --tags @home",
    "test:confirm": "ts-node src/utilities/RunTests.ts --tags @confirm",
    "test:verify": "ts-node src/utilities/RunTests.ts --tags @verify",
    "test:regression": "ts-node src/utilities/RunTests.ts --tags @regression",
    "report": "ts-node -e \"require('./src/utilities/ReportGenerator').ReportGenerator.generate()\""
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
